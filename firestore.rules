rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Admin verification via Firebase Custom Claims (set server-side only)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ✅ Check that the 'role' field was not modified by a non-admin
    function roleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // ✅ Email verification check
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // ═══════════════════════════════════════════════════
    // PRODUCTS — public read, admin-only write
    // ═══════════════════════════════════════════════════
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'slug', 'price', 'costPrice', 'originalPrice', 'discount',
          'images', 'colors', 'sizes', 'description', 'category',
          'tags', 'rating', 'reviewsCount', 'isNew', 'inStock'
        ])
        && request.resource.data.name is string
        && request.resource.data.price is number;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // ORDERS — validated create, owner-read, admin-manage
    // ═══════════════════════════════════════════════════
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'customer', 'items', 'totals', 'userId',
          'status', 'paymentMethod', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.paymentMethod in ['cod', 'cliq'];

      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // MESSAGES — validated create, admin-only management
    // ═══════════════════════════════════════════════════
    match /messages/{messageId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'message', 'isRead', 'createdAt'
        ])
        && request.resource.data.isRead == false
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;

      allow read, update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // USERS — owner profile + admin role management
    // ═══════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Users can create their own profile, but role must be 'user' or absent
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      // Users can update their own profile but CANNOT change the role field
      allow update: if request.auth != null
        && request.auth.uid == userId
        && roleUnchanged();

      // Admins can update any user (including role changes)
      allow update: if isAdmin();

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // ACTIVITY LOGS — admin-only (client writes allowed for logging)
    // ═══════════════════════════════════════════════════
    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
