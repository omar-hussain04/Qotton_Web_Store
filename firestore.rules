rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ✅ Admin verification — only your real email has full access
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "oh9500585@gmail.com";
    }

    // ✅ Products: Everyone can browse, only admin can modify
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ✅ Orders: Guests can create, owners can read their own, admin has full access
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }
    
    // ✅ Messages: Anyone can submit, only admin can read/manage
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // ✅ Users: Owner can read/write their own profile, admin can read all profiles
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
